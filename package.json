{
  "name": "debrief",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "AI performance coach for traders. Grades every session against your own rules.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run build && tsx server/index.ts --open",
    "dev": "concurrently -k -n app,companion -c yellow,cyan \"vite\" \"tsx watch server/index.ts\"",
    "companion": "tsx server/index.ts",
    "build": "vite build",
    "build:pages": "BASE_PATH=/debrief/ vite build",
    "deploy": "npm test && npm run build:pages && gh-pages -d dist --nojekyll",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@date-fns/tz": "^1.5.0",
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "chokidar": "^5.0.0",
    "hono": "^4.13.10",
    "idb-keyval": "^6.3.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.48.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
